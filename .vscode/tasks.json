{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Repository: check",
      "type": "shell",
      "command": "bun run check",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Repository: fix checks",
      "type": "shell",
      "command": "bun run check:fix",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Repository: typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Vitest: current file",
      "type": "shell",
      "command": "bun",
      "args": ["node_modules/vitest/vitest.mjs", "run", "${relativeFile}"],
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Vitest: watch",
      "type": "shell",
      "command": "bun run test:watch",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Oxlint package: typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "options": { "cwd": "${workspaceFolder}/packages/oxlint" },
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
