{
  "name": "forge",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "-------------------------------------------------------------------------": "",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "--------------------------------------------------------------------------": "",
    "typecheck": "turbo run typecheck //#typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "dts": "turbo run dts //#dts:root",
    "dts:root": "tsc -b --emitDeclarationOnly",
    "---------------------------------------------------------------------------": "",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "----------------------------------------------------------------------------": "",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "bun run lint --fix",
    "lint:monorepo": "sherif",
    "lint:dependencies": "syncpack lint",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "----------------------------------------------=------------------------------": "",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "-----------------------------------------------------------------------------": "",
    "postinstall": "turbo run postinstall //#postinstall:root",
    "postinstall:root": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@forge/oxlint": "workspace:*",
    "@forge/tsconfig": "workspace:*",
    "@types/node": "26.1.2",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/eslint-plugin": "1.6.24",
    "eslint-plugin-turbo": "2.10.8",
    "knip": "6.31.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-plugin-complexity": "2.1.6",
    "oxlint-tsgolint": "7.0.2001",
    "sherif": "1.13.0",
    "syncpack": "15.3.2",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "engines": {
    "bun": "bun@1.3.14",
    "node": "=26.5.0"
  },
  "packageManager": "bun@1.3.14"
}
