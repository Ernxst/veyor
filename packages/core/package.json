    "xstate": "6.0.0-alpha.27"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@ark/attest": "0.56.3",
    "@types/node": "26.1.2",
    "@veyorhq/tsconfig": "workspace:*",
    "publint": "0.3.22",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "typescript-attest": "npm:typescript@6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
