  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./actors": "./dist/actors.js",
    "./schema": "./dist/schema/index.js",
    "./schema/effect": "./dist/schema/effect.js",
    "./schema/typebox": "./dist/schema/typebox.js",
    "./schema/valibot": "./dist/schema/valibot.js",
    "./schema/validate": "./dist/schema/validate.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "-------------------------------------------------------------------------------": "",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc -b --noEmit",
    "--------------------------------------------------------------------------------": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:instantiations": "vitest run --project instantiations",
    "test:instantiations:update": "vitest run --project instantiations -u",
    "---------------------------------------------------------------------------------": ""
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "@standard-schema/spec": "1.1.0",
    "@valibot/to-json-schema": "1.7.1",
