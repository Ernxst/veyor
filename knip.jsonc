{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": ["oxlint.config.mts"],
      "ignoreDependencies": [
        "eslint-plugin-turbo",
        "oxlint-plugin-complexity",
        "@vitest/eslint-plugin",
      ],
    },
    "./examples/*": {
      // Factory assemblies are selected at runtime via a dynamic import in
      // scripts/deliver.ts (--factory), which knip cannot trace.
      "entry": ["scripts/*", "src/factories/*"],
    },
  },
}
