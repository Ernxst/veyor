{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": ["oxlint.config.mts"],
      "ignoreDependencies": [
        "eslint-plugin-turbo",
        "oxlint-plugin-complexity",
        "@vitest/eslint-plugin",
      ],
    },
    "./examples/*": {
      // veyor.config.ts is loaded at runtime by the veyor CLI via a dynamic
      // import, which knip cannot trace.
      "entry": ["veyor.config.ts", "src/assemblies/*"],
    },
  },
}
