# Auto detect text files and perform LF normalization
* text=auto

# Lockfile — don't diff in code review
bun.lock linguist-generated
package-lock.json linguist-generated
yarn.lock linguist-generated
pnpm-lock.yaml linguist-generated

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.webp binary
*.avif binary
*.ktx2 binary

# Merge strategy
bun.lock -merge
